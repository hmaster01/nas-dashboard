# Kopieren nach .env und ausfüllen:  cp .env.example .env && chmod 600 .env
# Die .env enthält Geheimnisse und gehört nie in Git (.gitignore schließt sie aus).

# ======================= 1. Anmeldung: eine der beiden Möglichkeiten =======================

# --- A) Basic-Auth (Standard, ein gemeinsames Konto) ---------------------------------------
# Das Passwort muss mindestens 24 Zeichen lang sein:  openssl rand -base64 24
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# --- B) Authentik (Anmeldung pro Person, Dienste je nach Gruppe) ---------------------------
# Sobald OIDC_ISSUER gesetzt ist, gilt B statt A. Einrichtung: siehe README, "Anmeldung über Authentik".
# OIDC_ISSUER=https://auth.home.arpa/application/o/nas-dashboard/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Adresse, unter der du das Dashboard im Browser aufrufst (nur Schema + Host). Mit https:// werden
# die Cookies automatisch als "Secure" gesetzt.
# PUBLIC_URL=https://dashboard.home.arpa
# Mindestens 32 Zeichen, geheim halten:  openssl rand -hex 32
# SESSION_SECRET=
# Wer die Systemwerte sieht und ALLE Dienste unabhängig von dashboard.groups (kommagetrennt):
# ADMIN_GROUPS=authentik Admins
# Läuft Authentik mit einem selbst signierten Zertifikat: Datei als ./config/ca.pem ablegen und aktivieren:
# NODE_EXTRA_CA_CERTS=/config/ca.pem

# ======================= 2. Docker-Erkennung und echte Host-Werte (optional) ===========================

# Einschalten, indem die zusätzliche Compose-Datei dazugenommen wird:
# COMPOSE_FILE=docker-compose.yml:docker-compose.discovery.yml

# Gemeinsames Geheimnis zwischen Dashboard und Agent (mindestens 24 Zeichen):  openssl rand -hex 32
# AGENT_TOKEN=

# Leerer Ordner auf der Datenplatte (vorher mit mkdir anlegen), wird nur zum Messen der Füllung eingebunden.
# Beispiel OpenMediaVault: /srv/dev-disk-by-uuid-XXXX/.dashboard-probe
# DATA_DISK_PROBE=

# Mehrere Platten: Name=Pfad im Container, kommagetrennt. Die erste steht in der Statusleiste.
# DISKS=Daten=/probe/daten
# Nur bestimmte Netzwerkkarten zählen (Standard: alle echten), z. B. NET_INTERFACES=enp3s0
# NET_INTERFACES=
# Port des Socket-Proxys auf 127.0.0.1, falls 2375 belegt ist:
# DOCKER_PROXY_PORT=2375

# ======================= 3. Version ===========================================================
# "latest" = jeweils neuester Stand. Zum Festhalten einer Version: z. B. sha-1a2b3c4
# DASHBOARD_TAG=latest
